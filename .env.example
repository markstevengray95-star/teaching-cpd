# Core CPD backend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical production origin used by OAuth, magic-link and password-reset callbacks.
NEXT_PUBLIC_APP_URL=https://schoolcpd.vercel.app

# AI CPD Coach — Gemini is the primary provider.
# Keep this server-only: never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_COACH_MODEL=gemini-3.8-flash

# Optional secondary provider. If Gemini is unavailable, the coach can use
# OpenAI before falling back to the built-in evidence-aware Smart Coach.
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-5.6-luna
